# Copy to deploy/.env and fill in. Never commit .env (it is gitignored).
# Generate secrets with:  openssl rand -base64 48

# Public address. A domain gives automatic HTTPS; "http://localhost" is for a local test only.
SITE_ADDRESS=tradesphere.example.com
# The exact origin users open in the browser (used for CORS).
SITE_URL=https://tradesphere.example.com

# Database. POSTGRES_PASSWORD is the superuser, used only to create the other roles.
# Each of the others has its own job (docs/operations.md, "Database roles").
POSTGRES_PASSWORD=change-me-superuser
OWNER_DB_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
PLATFORM_DB_PASSWORD=change-me-platform
BACKUP_DB_PASSWORD=change-me-backup

# Signing key for access tokens. Must be unique and at least 32 characters in production.
JWT_SECRET=change-me-to-a-long-random-secret-0123456789

# The stack's private network. Change only if it collides with a network on the host.
# STACK_SUBNET=172.30.0.0/24

# Error reports (optional): the DSN of a Sentry or compatible project.
SENTRY_DSN=

# Off-site backups (optional). Example for Backblaze B2 via rclone environment configuration:
# RCLONE_REMOTE=b2:tradesphere-backups
# RCLONE_CONFIG_B2_TYPE=b2
# RCLONE_CONFIG_B2_ACCOUNT=<key id>
# RCLONE_CONFIG_B2_KEY=<application key>
RCLONE_REMOTE=
