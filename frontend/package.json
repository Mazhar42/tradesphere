    "@tanstack/react-table": "^9.3.1",
    "clsx": "^2.1.1",
    "i18next": "^27.2.1",
    "lucide-react": "^1.75.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.2",
    "sonner": "^2.0.8",
